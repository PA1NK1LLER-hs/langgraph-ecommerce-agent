# ============================================================================
# 环境变量配置模板
# ============================================================================
# 使用方法和安装说明请查看 README.md。
#
# 快速开始:
#   1. 复制此文件:  cp .env.example .env
#   2. 填入你的 API Keys 和配置
#   3. 启动服务:     docker compose up -d  (或 python src/main.py)
#
# 安全提醒:
#   - .env 已在 .gitignore 中，不会被提交到 Git
#   - 不要在此文件 (.env.example) 中填写真实的 API Key
#   - 所有 API Key 请先在服务商后台配置 IP 白名单
# ============================================================================


# ──────────────────────────────────────────────────────────────────────────
# LLM 配置（必需）
# ──────────────────────────────────────────────────────────────────────────
# 主模型 — 用于规划、推理、复杂工具调用
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# Flash 模型 — 用于摘要、查询改写、轻量分类（需支持较快的推理速度）
LLM_FLASH_MODEL=deepseek-v4-flash

# 备用模型 — 主模型不可用时自动切换（可选）
# 运行时回退链：路由模型 → 另一档模型 → LLM_FALLBACK_MODEL → LLM_FALLBACK_MODEL_2
LLM_FALLBACK_MODEL=
LLM_FALLBACK_MODEL_2=

# 视觉模型 — 多模态（文本+图片 → 文本），用于图片 OCR/描述。
# 默认复用主模型的 key/base_url；需要独立视觉网关时单独设 VISION_API_KEY / VISION_BASE_URL。
VISION_ENABLED=true
VISION_MODEL=deepseek-v4-flash-vision-exp
#VISION_API_KEY=
#VISION_BASE_URL=

# Flash/Pro 路由阈值（约 90% 请求走 Flash，Pro 只处理少数高难度请求）
# complex 意图且用户单条输入超过该字符数，或会话消息数超过该值，才升级到 Pro
PRO_ROUTE_MIN_CHARS=1000
PRO_ROUTE_MIN_MESSAGES=30


# ──────────────────────────────────────────────────────────────────────────
# Embedding 服务（OpenAI 兼容端点，必需）
# ──────────────────────────────────────────────────────────────────────────
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024


# ──────────────────────────────────────────────────────────────────────────
# Rerank 服务（可选 — 不设置则跳过重排序）
# ──────────────────────────────────────────────────────────────────────────
# RERANK_API_KEY 默认复用 EMBEDDING_API_KEY
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank


# ──────────────────────────────────────────────────────────────────────────
# Qdrant 向量数据库（必需）
# ──────────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=


# ──────────────────────────────────────────────────────────────────────────
# Neo4j 图数据库 — LightRAG 图存储（必需）
# ──────────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-please


# ──────────────────────────────────────────────────────────────────────────
# PostgreSQL — LangGraph checkpoint 持久化 + 用户/线程元数据（必需）
# ──────────────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://langgraph:change-me@localhost:5433/langgraph
POSTGRES_SCHEMA=langgraph


# ──────────────────────────────────────────────────────────────────────────
# Redis — 可选（用于跨进程限流、语义缓存）
# ──────────────────────────────────────────────────────────────────────────
REDIS_URL=


# ──────────────────────────────────────────────────────────────────────────
# 网页搜索（可选）
# ──────────────────────────────────────────────────────────────────────────
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=tvly-your-tavily-key


# ──────────────────────────────────────────────────────────────────────────
# JWT 认证（必需 — 生产环境必须更换！）
# ──────────────────────────────────────────────────────────────────────────
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=


# ──────────────────────────────────────────────────────────────────────────
# MCP 传输配置（可选 — 取消注释以使用 Streamable HTTP 替代 stdio）
# ──────────────────────────────────────────────────────────────────────────
# MCP_PLAYWRIGHT_URL=http://localhost:8931/mcp
# MCP_FILESYSTEM_URL=http://localhost:8015/mcp
# MCP_SEQUENTIALTHINKING_URL=http://localhost:8005/mcp
# MCP_TIME_URL=http://localhost:8016/mcp
# MCP_DOCKER_URL=http://localhost:8017/mcp
# MCP_SEARXNG_URL=http://localhost:8089/mcp

# SearXNG 实例地址（MCP 搜索后端）
SEARXNG_INSTANCE_URL=http://localhost:8088


# ──────────────────────────────────────────────────────────────────────────
# 可观测性 — LangFuse（可选）
# ──────────────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SESSION_ID=langgraph-agent
LANGFUSE_USER_ID=default


# ──────────────────────────────────────────────────────────────────────────
# Data / Storage 路径
# ──────────────────────────────────────────────────────────────────────────
DATA_DIR=./src/data
USER_MEMORY_DIR=./src/data/user_memory
LIGHTRAG_WORKING_DIR=./src/data/lightrag


# ──────────────────────────────────────────────────────────────────────────
# Mem0 用户记忆系统
# ──────────────────────────────────────────────────────────────────────────
MEM0_COLLECTION_NAME=mem0_user_memories
MEM0_LLM_MODEL=deepseek-v4-pro
MEM0_EMBEDDING_DIMS=1024


# ──────────────────────────────────────────────────────────────────────────
# 安全护栏
# ──────────────────────────────────────────────────────────────────────────
# 启用 LLM 二次分类（更准确但增加延迟和成本，默认 false）
SECURITY_LLM_GUARD=false


# ──────────────────────────────────────────────────────────────────────────
# 审批与权限
# ──────────────────────────────────────────────────────────────────────────
# 审批模式: "standard"（标准）| "strict"（所有高风险操作需审批）| "permissive"（跳过审批）
APPROVAL_MODE=standard

# 审批等待超时（秒），超时自动拒绝
APPROVAL_TTL_SECONDS=300


# ──────────────────────────────────────────────────────────────────────────
# 紫鸟 RPA（可选 — 仅电商自动化的用户需要配置）
# ──────────────────────────────────────────────────────────────────────────
# ZINIAO_COMPANY=your-company-name
# ZINIAO_USERNAME=your-username
# ZINIAO_PASSWORD=your-password
# ZINIAO_CLIENT_PATH=D:\software\ziniao\ziniao.exe   # Windows; Linux: /opt/ziniao/ziniaobrowser
# ZINIAO_SOCKET_PORT=16851
# ZINIAO_STORES=店铺名称1:店铺ID1,店铺名称2:店铺ID2
# CAMPAIGN_SPEND_EXCEL_PATH=C:\path\to\ad-spend-data.xlsx


# ──────────────────────────────────────────────────────────────────────────
# RPA 任务队列可靠性（rpa_jobs / mcp_setup）
# ──────────────────────────────────────────────────────────────────────────
# MCP_RPA_URL=                 # RPA 独立 executor 的 HTTP 端点（不设则本机 stdio 子进程）
# RPA_MCP_TOKEN=               # 远程部署鉴权（RPA server 侧设置后，agent 自动带 X-RPA-Token）
# RPA_DRY_RUN=1                # 冒烟/演示：调度器跳过真实 MCP 调用，直接标 done + 假结果（只读）
# RPA_EXEC_TIMEOUT_SECONDS=1200        # 单次「连接 + call_tool」超时，防 MCP 挂起占死队列（默认 1200）
# RPA_JOB_MAX_RUNTIME_SECONDS=1800     # running 僵死守护阈值，超时自动标 failed（默认 1800）
# RPA_MCP_RECONNECT_BACKOFF_SECONDS=60 # RPA MCP 连接失败后的退避窗口，窗口外自动重连（默认 60）


# ──────────────────────────────────────────────────────────────────────────
# 世贸通抬头报关（可选 — 仅外贸报关自动化的用户需要配置）
# ──────────────────────────────────────────────────────────────────────────
# SHIMAOTONG_BASE_URL=https://work.shimaotong.com
# SHIMAOTONG_USERNAME=your-username
# SHIMAOTONG_PASSWORD=your-password
# SHIMAOTONG_USER_ID=your-user-id        # 订单默认 userId（世贸通系统内账号 id）
# SHIMAOTONG_TRACKING_BASE=              # 跟踪表网络共享根路径（可选）。必须用双反斜杠 UNC 前缀：
#                                        #   \\192.168.10.4\业务板块\出运汇总\000出运明细资料汇总-23
#                                        # 注意：写单反斜杠（\192.168.10.4\...）会导致 dotenv 解析失败 + 路径不可达，自动发现为空


# ──────────────────────────────────────────────────────────────────────────
# 亚马逊轨迹跟踪表（可选 — 领星ERP + 紫鸟 RPA 用户需要配置）
# ──────────────────────────────────────────────────────────────────────────
# 完整流程：领星ERP下载最新FBA库存 → 紫鸟开店铺爬取各货件实际接收/状态 → 写回共享盘跟踪表
# LINGXING_USERNAME=your-lingxing-username
# LINGXING_PASSWORD=your-lingxing-password
#
# TRACK_TABLE_STORES: JSON。键=中文店铺标签（输出文件名 = {outDir}/{标签}轨迹跟踪表.xlsx）。
#   browserOauth 取自紫鸟店铺；inventory 为 站点→库存店铺过滤串。
#   注意：JSON 字符串内的反斜杠必须写成 \\（JSON 转义），例如 UNC 双反斜杠写成 \\\\：
# TRACK_TABLE_STORES={"巧逗豆":{"browserName":"巧逗豆-US","browserOauth":"27153125947492","outDir":"\\\\192.168.10.27\\共享文件夹\\16.亚马逊轨迹跟踪表","inventory":{"美国":"巧逗豆-US","加拿大":"巧逗豆-CA"}},"天安":{"browserName":"上海天安-US本土店","browserOauth":"27678664116395","outDir":"\\\\192.168.10.27\\共享文件夹\\亚马逊rpa流程\\天安轨迹表+跟踪表","inventory":{"美国":"天安-Fond&Found-US-US","加拿大":"天安-Fond&Found-US-CA"}}}
#
# 以下路径必须用双反斜杠 UNC 前缀（\\192.168...）。dotenv 对无引号值不做转义、
# 会原样保留；不要写单反斜杠（\192.168...），那不是有效 UNC 且可能导致路径不可达。
# TRACK_TABLE_CONTRACT_PATH=\\192.168.10.27\共享文件夹\亚马逊rpa流程\轨迹表+跟踪表\1.订单合同汇总.xlsx
# TRACK_TABLE_PASSKEY_TEMPLATE=\\192.168.10.27\共享文件夹\passkey_btn_template.png
# TRACK_TABLE_INVENTORY_SAVE_PATH=\\192.168.10.27\共享文件夹\亚马逊rpa流程\轨迹表+跟踪表\FBA仓库明细-FBA库存.xlsx


# ──────────────────────────────────────────────────────────────────────────
# 默认用户（可选 — 开发环境跳过认证时使用）
# ──────────────────────────────────────────────────────────────────────────
AGENT_USER_ID=default_user
